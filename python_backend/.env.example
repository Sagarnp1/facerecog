# Firebase Service Account JSON file path
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Server Configuration
HOST=10.172.135.246
PORT=8000

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6
FRAME_SKIP=3

# Auto-Scheduler Capture Settings
# Number of times to capture during each class (default: 10)
AUTO_CAPTURES_PER_CLASS=10
# Duration of each capture in seconds (default: 5)
CAPTURE_DURATION_SECONDS=5

# Firestore Collections
STUDENTS_COLLECTION=students
ATTENDANCE_COLLECTION=attendance
SESSIONS_COLLECTION=sessions
